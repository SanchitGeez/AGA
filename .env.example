# Enquiry + résumé email (app/api/enquiry). Copy to .env.local and fill in.
# Get a key at https://resend.com (free tier). Submissions email the firm; the
# résumé is attached and never stored.

# Required — Resend API key.
RESEND_API_KEY=

# Optional — where enquiries are delivered. In Resend test mode this MUST be the
# email you signed up with. Defaults to the firm's first address in lib/site.ts.
ENQUIRY_TO=

# Optional — sender address. Leave blank to use Resend's shared onboarding
# sender. Once you verify the firm's domain in Resend, set e.g.
# ENQUIRY_FROM="AGA & Associates <enquiries@agaassociates.in>"
ENQUIRY_FROM=
