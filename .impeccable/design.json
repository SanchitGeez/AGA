  "components": [
    {
      "name": "Photographic Service Link",
      "kind": "custom",
      "refersTo": "service-photo-link",
      "description": "A ruled direct service link over a local reading ground; fixed photo-caption tokens retain contrast in either page theme. Primitives are defined in DESIGN.md frontmatter.",
      "html": "<div class=\"ds-photo-caption\"><a class=\"ds-photo-service\" href=\"#service\"><span>Secretarial Audit<span class=\"ds-photo-law\">§204 · MR-3</span></span><span class=\"ds-photo-arrow\" aria-hidden=\"true\">→</span></a></div>",
      "css": ".ds-photo-caption { background: var(--photo-ground); color: var(--photo-ink); padding: 20px; border-radius: 12px; } .ds-photo-service { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 80px; border-top: 1px solid var(--photo-rule); padding: 12px 0; color: var(--photo-ink); font-family: var(--font-sans); font-size: 18px; line-height: 1.55; text-decoration: underline; text-underline-offset: 4px; transition: color 140ms; } .ds-photo-law { display: block; margin-top: 4px; color: var(--photo-dim); font-family: var(--font-mono); font-size: 16px; } .ds-photo-arrow { color: var(--photo-signal); transition: transform 140ms; } .ds-photo-service:hover { color: var(--photo-signal); } .ds-photo-service:hover .ds-photo-arrow { transform: translateX(4px); } .ds-photo-service:focus-visible { outline: 3px solid var(--photo-signal); outline-offset: 4px; } @media (prefers-reduced-motion: reduce) { .ds-photo-arrow { transition: none; transform: none !important; } }"
    },
    {
      "name": "Primary Action",
      "kind": "button",
